#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules/xgplayer/bin/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules/xgplayer/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules/xgplayer/bin/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules/xgplayer/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/xgplayer@2.32.6/node_modules:/homework/continew-admin-ui/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../xgplayer/bin/xgplayer.js" "$@"
else
  exec node  "$basedir/../xgplayer/bin/xgplayer.js" "$@"
fi
